---
import '@fontsource-variable/inter';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShareImage from '../assets/projects/liberation-2025.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Social card image. Defaults to a representative archive photograph. */
  shareImage?: ImageMetadata;
  /** Set on redirect stubs so search engines don't index them. */
  noindex?: boolean;
}

const {
  title = 'See My World Archive',
  description = 'An interactive archive of See My World — photography, performance and community history across Manchester and Lagos.',
  shareImage = defaultShareImage,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : `${base}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const share = await getImage({
  src: shareImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const shareImageUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#050505" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="See My World Archive" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(share.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(share.attributes.height ?? 630)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />

    <link rel="icon" type="image/svg+xml" href={`${publicBase}site-favicon.svg`} />
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #050505;
        --bg-soft: #0b0b0b;
        --panel: rgba(13, 13, 13, 0.88);
        --text: #f4f1ec;
        --muted: rgba(244, 241, 236, 0.66);
        --line: rgba(255, 53, 53, 0.92);
        --line-soft: rgba(255, 53, 53, 0.32);
        --shadow: rgba(0, 0, 0, 0.55);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        width: 100%;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      body {
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 2px solid var(--line);
        outline-offset: 2px;
      }

      .visually-hidden:not(:focus-within) {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>
  </head>
  <body data-base={publicBase}>
    <slot />
  </body>
</html>
