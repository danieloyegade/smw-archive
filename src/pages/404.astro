---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/projects';

const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : `${base}/`;
const entries = (await getProjects()).slice(0, 6);
---

<BaseLayout
  title="Page not found | See My World Archive"
  description="That page is not in the See My World Archive."
  noindex
>
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1>Not in the archive</h1>
    <p class="lead">That page has moved or never existed. Start from the archive, or try one of these entries.</p>
    <a class="home" href={publicBase}>Return to archive</a>
    <ul>
      {
        entries.map((entry) => (
          <li>
            <a href={`${publicBase}archive/${entry.id}/`}>
              <strong>{entry.data.title}</strong>
              <small>
                {entry.data.category} · {entry.data.year}
              </small>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <style>
    .not-found {
      max-width: 52rem;
      margin: 0 auto;
      padding: clamp(3rem, 12vh, 8rem) 1.5rem 4rem;
    }

    .eyebrow {
      margin: 0;
      color: #ff3535;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.3em;
    }

    h1 {
      margin: 0.8rem 0 0;
      font-size: clamp(2.2rem, 8vw, 4rem);
      line-height: 1;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .lead {
      margin: 1.4rem 0 0;
      max-width: 34rem;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.7;
    }

    .home {
      display: inline-block;
      margin-top: 1.8rem;
      padding: 0.7rem 1.1rem;
      border: 1px solid var(--line);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .home:hover {
      background: rgba(255, 53, 53, 0.12);
    }

    ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
      gap: 1px;
      margin: 3.5rem 0 0;
      padding: 0;
      list-style: none;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    li a {
      display: block;
      height: 100%;
      padding: 1rem;
      background: var(--bg);
    }

    li a:hover,
    li a:focus-visible {
      background: rgba(255, 53, 53, 0.09);
    }

    strong {
      display: block;
      font-size: 0.88rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    small {
      display: block;
      margin-top: 0.3rem;
      color: var(--muted);
      font-size: 0.72rem;
    }
  </style>
</BaseLayout>
