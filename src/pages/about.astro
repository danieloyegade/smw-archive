---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : base + '/';
const asset = (name: string) => publicBase + 'images/events/' + name + '.webp';
---

<BaseLayout title="About | See My World Archive" description="The story and purpose behind See My World, a year-round programme of Pan-African arts, culture and community.">
  <div class="page">
    <header class="site-header">
      <a class="wordmark" href={publicBase} aria-label="See My World archive home"><img src={asset('see-my-world-logo')} alt="See My World" /></a>
      <nav aria-label="Main navigation"><a href={publicBase}>Explore the archive</a><a href={publicBase + 'about/'} aria-current="page">About</a></nav>
    </header>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">About / See My World</p>
          <h1>Culture in <span>motion.</span></h1>
          <p class="lead">See My World brings Pan-African stories into view through art, film, music, movement and shared experience.</p>
          <a href="#story">Discover the story <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-image"><img src={asset('connected-fragments-private-viewing-1')} alt="People at a See My World exhibition" /></div>
      </section>

      <section class="origin" id="story">
        <div class="section-label">01 / Where it began</div>
        <div class="origin-copy">
          <h2>Rooted in Manchester. Connected to the world.</h2>
          <p>See My World began in October 2020 as an online festival commemorating the 75th anniversary of the Fifth Pan-African Congress, held in Manchester in 1945. It brought people together through performances, film and conversations about identity, history and the future.</p>
          <p>What began as a festival has grown into a year-round programme. Its work supports cultural expression and learning across African and Caribbean communities, creating space for artists, audiences and ideas to meet.</p>
        </div>
      </section>

      <section class="practice">
        <div class="practice-copy">
          <span class="section-label">02 / The practice</span>
          <h2>Many forms.<br /><span>One world.</span></h2>
          <p>Music, film, dance, visual art and poetry all have a place here. So do workshops, debate and education. Each form offers a different way to tell stories, share knowledge and build connections.</p>
        </div>
        <div class="practice-image"><img src={asset('festival-2021-1')} alt="A See My World festival gathering" loading="lazy" /></div>
      </section>

      <section class="exchange">
        <div class="exchange-image"><img src={asset('lagos-trip-1')} alt="A moment from the See My World Lagos trip" loading="lazy" /></div>
        <div class="exchange-copy">
          <span class="section-label">03 / Across cities</span>
          <h2>Manchester<br /><span>meets Lagos.</span></h2>
          <p>See My World has brought artists from Manchester and Lagos into an international exchange. Their collaborations move across film, photography, sound and performance, reflecting the cities they inhabit and the relationships between them.</p>
          <p>This archive preserves those encounters alongside the festivals, exhibitions and community moments that continue to shape the programme.</p>
          <a href={publicBase + '#world'}>Enter the archive <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>
    <footer><span>SEE MY WORLD / AN INTERACTIVE ARCHIVE</span><a href={publicBase}>Explore the stories ↑</a></footer>
  </div>
  <style>
    .page { min-height: 100vh; background: #050505; color: #f8f8f5; }
    .site-header { min-height: 106px; border-bottom: 1px solid #722322; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.4rem clamp(1.25rem, 3vw, 3.5rem); }
    .wordmark { display: block; width: min(430px, 39vw); }
    .wordmark img { width: 100%; height: auto; }
    nav { display: flex; gap: 2rem; }
    nav a { font-size: .69rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
    nav a[aria-current], nav a:hover, footer a:hover { color: #69b96e; }
    .hero { display: grid; grid-template-columns: 1fr 43%; min-height: min(760px, calc(100svh - 106px)); border-bottom: 1px solid #722322; }
    .hero-copy { display: flex; flex-direction: column; align-items: start; justify-content: end; padding: clamp(3rem, 6vw, 7rem); }
    .eyebrow, .section-label { color: #ef4b43; font-size: .7rem; font-weight: 900; letter-spacing: .17em; text-transform: uppercase; }
    h1, h2, p { margin-top: 0; }
    h1 { font-size: clamp(4rem, 7vw, 8rem); line-height: .9; letter-spacing: -.075em; text-transform: uppercase; margin: 1rem 0 2rem; }
    h1 span, h2 span { color: #69b96e; }
    .lead { max-width: 36rem; font-size: clamp(1.1rem, 1.6vw, 1.5rem); line-height: 1.5; color: #d0d3ce; }
    .hero-copy a, .exchange-copy a { display: inline-flex; gap: 1rem; padding-bottom: .45rem; border-bottom: 1px solid #ef4b43; margin-top: 1.2rem; text-transform: uppercase; font-size: .69rem; font-weight: 900; letter-spacing: .11em; }
    .hero-copy a span, .exchange-copy a span { color: #ef4b43; }
    .hero-copy a:hover, .exchange-copy a:hover { color: #69b96e; }
    .hero-image, .practice-image, .exchange-image { overflow: hidden; background: #111; }
    .hero-image img, .practice-image img, .exchange-image img { width: 100%; height: 100%; object-fit: cover; }
    .origin { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; padding: 6rem clamp(1.25rem, 5vw, 6rem); border-bottom: 1px solid #722322; }
    .origin-copy { max-width: 860px; }
    h2 { font-size: clamp(2.7rem, 5vw, 5.7rem); line-height: .97; letter-spacing: -.065em; text-transform: uppercase; margin-bottom: 2rem; }
    .origin-copy p, .practice-copy p, .exchange-copy p { color: #c5c9c2; font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.65; max-width: 42rem; }
    .practice, .exchange { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid #722322; min-height: 600px; }
    .practice-copy, .exchange-copy { align-self: center; padding: clamp(3rem, 6vw, 7rem); }
    .practice-copy h2, .exchange-copy h2 { margin-top: 1.1rem; }
    footer { display: flex; justify-content: space-between; gap: 1rem; padding: 1.5rem clamp(1.25rem, 5vw, 6rem); font-size: .63rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    @media (max-width: 800px) {
      .hero { grid-template-columns: 1fr; }
      .hero-copy { min-height: 500px; padding: 3rem 1.5rem; }
      .hero-image { height: 390px; }
      .origin { grid-template-columns: 1fr; padding: 4rem 1.5rem; }
      .practice, .exchange { grid-template-columns: 1fr; }
      .practice-image, .exchange-image { height: 420px; }
      .exchange-image { order: 2; }
      .practice-copy, .exchange-copy { padding: 4rem 1.5rem; }
    }
    @media (max-width: 600px) {
      .site-header { min-height: 74px; padding: 1rem; }
      .wordmark { width: 47vw; }
      nav { gap: .6rem; }
      nav a { font-size: .54rem; }
      .hero-copy { min-height: 480px; padding: 2.5rem 1rem; }
      h1 { font-size: clamp(3.6rem, 11vw, 5rem); }
      .origin { padding: 3.5rem 1rem; }
      .practice-copy, .exchange-copy { padding: 3.5rem 1rem; }
      footer { flex-direction: column; }
    }
  </style>
</BaseLayout>
