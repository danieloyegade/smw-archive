---
import type { ArchiveProject } from '../data/projects';
import { formatDuration } from '../data/experience';
const { project, publicBase } = Astro.props as { project: ArchiveProject; publicBase: string };
const asset = (path: string) => publicBase + path.replace(/^\//, '');
---
{project.media?.length && <section class="media-section" id="experience" aria-labelledby="media-heading">
  <div class="media-heading"><span>Watch. Listen. Be here.</span><h2 id="media-heading">Inside the moment<span>.</span></h2><p>Press play when you’re ready. Use headphones for sound, or explore the photographs and story in your own time.</p></div>
  <div class:list={['media-list', {'single': project.media.length === 1}]}>
    {project.media.map((item) => {
      const Tag = item.longForm ? 'details' : 'article';
      return <Tag id={'player-' + item.src.split('/').pop()?.split('.')[0]} class:list={['media-item', {'audio-item': item.kind === 'audio','long-form':item.longForm}]}>
      {item.longForm && <summary>Stay for the complete film <span>{formatDuration(item.seconds)}</span></summary>}
      <div class="media-frame">
        {item.kind === 'video' ? <video class:list={{portrait:item.portrait}} controls playsinline preload="none" poster={asset(item.poster ?? project.image)} aria-label={item.title} aria-describedby={'summary-' + item.src.split('/').pop()?.split('.')[0]}>
          <source src={asset(item.src)} type="video/mp4" />
          {item.captions && <track kind="captions" src={asset(item.captions)} srclang="en" label="English (automatic)" default />}
          Your browser cannot play this film. <a href={asset(item.src)}>Open the film</a>.
        </video> : <><img src={asset(item.poster ?? project.image)} alt={project.alt} loading="lazy" /><div class="audio-player"><span>Listen with headphones · {formatDuration(item.seconds)}</span><audio controls preload="none" aria-label={item.title} aria-describedby={'summary-' + item.src.split('/').pop()?.split('.')[0]}><source src={asset(item.src)} type="audio/mpeg" />Your browser cannot play this audio. <a href={asset(item.src)}>Open the audio</a>.</audio></div></>}
      </div>
      <div class="media-copy"><small>{item.kind === 'video' ? 'Film' : 'Audio'} / {formatDuration(item.seconds)}</small><h3>{item.title}</h3><p id={'summary-' + item.src.split('/').pop()?.split('.')[0]}>{item.description}</p>{item.note && <p class="media-note">{item.note}</p>}
        {item.transcript?.length && <details class="transcript"><summary>Read the transcript <span>(automatic)</span></summary><p class="transcript-note">Transcribed from the recording. Some wording may contain errors.</p><div>{item.transcript.map(line=><p><button type="button" data-transcript-time={line.start} aria-label={'Play from '+formatDuration(line.start)}>{formatDuration(line.start)}</button><span>{line.text}</span></p>)}</div></details>}
      </div>
    </Tag>})}
  </div>
  <p class="playback-status" data-playback-status role="status"></p>
</section>}
<script>
  const players = [...document.querySelectorAll<HTMLMediaElement>('video, audio')];
  for (const player of players) {
    player.addEventListener('play', () => players.forEach((other) => { if (other !== player) other.pause(); }));
    player.addEventListener('ended', () => {
      const status = document.querySelector<HTMLElement>('[data-playback-status]');
      if (status) status.textContent = 'Stay with the photographs, or continue to the next story below.';
    });
  }
  window.addEventListener('pagehide', () => players.forEach((player) => player.pause()));
  document.addEventListener('visibilitychange', () => { if (document.hidden) players.forEach((player) => player.pause()); });
  document.querySelectorAll<HTMLButtonElement>('[data-transcript-time]').forEach(button=>button.addEventListener('click',()=>{
    const player = button.closest('.media-item')?.querySelector<HTMLMediaElement>('video,audio');
    if(!player)return;
    const start = Number(button.dataset.transcriptTime);
    const seek = () => { player.currentTime=start;player.play().catch(()=>{
      const status=document.querySelector<HTMLElement>('[data-playback-status]');
      if(status)status.textContent='Use the player’s play button to listen from this point.';
    }); };
    if(player.readyState===0){player.addEventListener('loadedmetadata',seek,{once:true});player.load();}else seek();
  }));
</script>
<style>
  .media-section { padding: 4rem clamp(1.25rem,5vw,6rem); border-bottom: 1px solid var(--line-soft); scroll-margin-top: 1rem; }
  .media-heading > span { color: var(--red); font-size: .67rem; text-transform: uppercase; font-weight: 900; letter-spacing: .13em; }
  .media-heading h2 { font-size: clamp(2.5rem,5vw,5.5rem); text-transform: uppercase; line-height: .97; letter-spacing: -.06em; margin: .85rem 0 1rem; }
  .media-heading h2 span { color: var(--green); }
  .media-heading > p { max-width: 650px; color: #c0c6ba; line-height: 1.6; font-size: .9rem; margin-bottom: 2rem; }
  .media-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; }
  .media-list.single { grid-template-columns: minmax(0,1fr); }
  .long-form { grid-column:1/-1; }
  .long-form > summary { padding:1.25rem;cursor:pointer;color:var(--green);font-weight:800;min-height:60px; }
  .long-form > summary span { margin-left:1rem;color:#c0c6ba;font-weight:400; }
  .transcript { margin-top:1.25rem;border-top:1px solid #40543b;padding-top:1rem; }
  .transcript > summary { min-height:44px;cursor:pointer;font-size:.85rem;color:var(--green); }
  .transcript > summary span { color:#aeb4ac; font-weight:400; }
  .transcript .transcript-note { font-size:.72rem;color:#aeb4ac; }
  .transcript > div { max-height:350px;overflow:auto;overscroll-behavior:contain; }
  .transcript > div > p { display:grid;grid-template-columns:50px 1fr;gap:.75rem;align-items:start;margin:.8rem 0; }
  .transcript button { font:inherit;font-size:.75rem;min-height:44px;border:1px solid #40543b;background:#142113;color:var(--green);cursor:pointer; }
  .transcript button:focus-visible { outline:2px solid #fff;outline-offset:2px; }
  .media-item { min-width: 0; background: #0c100c; border: 1px solid var(--line-soft); scroll-margin-top: 1rem; }
  .media-frame { position: relative; background: #000; }
  video { display: block; width: 100%; height: auto; max-height: 72svh; aspect-ratio: 16 / 10; object-fit: contain; }
  video.portrait { width: min(100%, calc(75svh * 9 / 16)); max-height: none; aspect-ratio: 9 / 16; margin-inline: auto; }
  .media-copy { padding: 1.25rem; }
  .media-copy small { color: var(--green); text-transform: uppercase; font-size: .65rem; letter-spacing: .12em; font-weight: 900; }
  .media-copy h3 { font-size: clamp(1.2rem,2vw,2rem); line-height: 1.15; margin: .6rem 0; }
  .media-copy p { color: #c0c6ba; max-width: 750px; line-height: 1.6; font-size: .9rem; margin: .5rem 0 0; }
  .media-copy .media-note { color: var(--green); font-size: .75rem; }
  .audio-item .media-frame > img { width: 100%; height: 400px; object-fit: cover; opacity: .75; }
  .audio-player { position: absolute; bottom: 0; left: 0; right: 0; padding: 2.5rem 1.25rem 1.25rem; background: linear-gradient(transparent,#000e); display: grid; gap: .8rem; }
  .audio-player span { font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  audio { width: min(100%,600px); }
  .playback-status { color: var(--green); font-size: .8rem; }
  .playback-status:empty { display: none; }
  @media(max-width:680px) { .media-list { grid-template-columns: minmax(0,1fr); } .media-section { padding: 3rem 1rem; } .audio-item .media-frame > img { height: 320px; } }
</style>
