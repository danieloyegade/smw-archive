---
import { getImage } from 'astro:assets';
import { getProjects, toClientProjects } from '../lib/projects';

const entries = await getProjects();
const clientProjects = await toClientProjects(entries);

const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : `${base}/`;

/** Small thumbnails for the list view. */
const thumbnails = new Map(
  await Promise.all(
    entries
      .filter((entry) => entry.data.image)
      .map(async (entry) => {
        const thumbnail = await getImage({
          src: entry.data.image!,
          width: 160,
          height: 120,
          fit: 'cover',
          format: 'webp',
        });
        return [entry.id, thumbnail.src] as const;
      }),
  ),
);
---

<section class="archive-shell" data-archive-shell>
  <header class="archive-header">
    <div>
      <p class="brand">SEE MY WORLD</p>
      <p class="brand-sub">ARCHIVE</p>
    </div>
    <div class="header-actions">
      <p class="header-note" data-globe-hint>DRAG, SCROLL OR USE ARROW KEYS</p>
      <button class="view-toggle" type="button" data-view-toggle aria-pressed="false">
        <span data-view-toggle-label>List view</span>
      </button>
    </div>
  </header>

  <section class="search-panel" aria-label="Search the archive">
    <label class="search-label" for="archive-search">Search the archive</label>
    <div class="search-field">
      <span aria-hidden="true">⌕</span>
      <input
        id="archive-search"
        type="search"
        placeholder="Projects, places, years…"
        autocomplete="off"
        data-search-input
      />
      <kbd>/</kbd>
    </div>
    <div class="search-results" data-search-results hidden>
      <p class="result-count" data-result-count aria-live="polite"></p>
      <div class="result-list" data-result-list></div>
    </div>
  </section>

  <div class="globe-controls" data-globe-controls aria-label="Globe controls">
    <button type="button" data-zoom-in aria-label="Zoom in">+</button>
    <button type="button" data-zoom-out aria-label="Zoom out">−</button>
    <button class="reset-control" type="button" data-reset-view>Reset view</button>
  </div>

  <div class="stage" data-stage>
    <div class="caption" aria-hidden="true">
      <div class="caption-title" data-caption-title>DRAG TO EXPLORE · SELECT TO OPEN</div>
      <div class="caption-meta" data-caption-meta></div>
    </div>
    <canvas id="globe-canvas" data-globe-canvas aria-hidden="true"></canvas>
  </div>

  <!--
    The authoritative, always-rendered index. The globe is an enhancement layered
    over this list: without JavaScript or WebGL, or with a screen reader or
    keyboard, this is the archive.
  -->
  <div class="archive-list" data-archive-list>
    <h1 class="list-heading">See My World Archive</h1>
    <p class="list-intro">
      {entries.length} entries of photography, performance and community history across Manchester and Lagos.
    </p>
    <p class="globe-fallback" data-globe-fallback hidden>
      The interactive globe could not start in this browser, so the archive is shown as a list.
    </p>
    <ol class="list-grid">
      {
        entries.map((entry) => (
          <li>
            <a href={`${publicBase}archive/${entry.id}/`}>
              <span class="list-number">{String(entry.data.order).padStart(2, '0')}</span>
              {thumbnails.has(entry.id) ? (
                <img
                  class="list-thumb"
                  src={thumbnails.get(entry.id)}
                  alt=""
                  width="160"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="list-thumb list-thumb-empty" aria-hidden="true" />
              )}
              <span class="list-copy">
                <strong>{entry.data.title}</strong>
                <small>
                  {entry.data.category} · {entry.data.year}
                  {entry.data.places.length > 0 && ` · ${entry.data.places.join(', ')}`}
                </small>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script is:inline type="application/json" data-archive-projects set:html={JSON.stringify(clientProjects)}></script>

<script>
  import { mountArchiveGlobe } from '../scripts/archive-globe';
  mountArchiveGlobe();
</script>

<style>
  .archive-shell {
    position: relative;
    min-height: 100svh;
    background:
      radial-gradient(circle at 50% 44%, rgba(255, 46, 46, 0.08), transparent 28%),
      radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.04), transparent 36%),
      var(--bg);
  }

  /*
    List view is the default so that the archive is complete before any script
    runs. `data-view` is only ever set by the globe script, and only after the
    WebGL context is live.
  */
  .stage,
  .globe-controls,
  .header-note,
  .view-toggle {
    display: none;
  }

  [data-view] .view-toggle {
    display: inline-flex;
  }

  [data-view='globe'] {
    overflow: hidden;
  }

  [data-view='globe'] .stage {
    display: block;
  }

  [data-view='globe'] .globe-controls {
    display: flex;
  }

  [data-view='globe'] .archive-list {
    display: none;
  }

  @media (min-width: 761px) {
    [data-view='globe'] .header-note {
      display: block;
    }
  }

  .archive-header {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 1.6rem;
    z-index: 5;
    letter-spacing: 0.26em;
  }

  .header-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .view-toggle {
    align-items: center;
    min-height: 2.4rem;
    padding: 0 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(5, 5, 5, 0.82);
    color: var(--text);
    font: inherit;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(14px);
  }

  .view-toggle:hover {
    border-color: var(--line);
  }

  .search-panel {
    position: absolute;
    top: 6.2rem;
    left: 1.6rem;
    z-index: 4;
    width: min(23rem, calc(100vw - 3.2rem));
  }

  .search-label {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .search-field {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 3rem;
    padding: 0 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(5, 5, 5, 0.84);
    backdrop-filter: blur(16px);
    transition: border-color 160ms ease, background 160ms ease;
  }

  .search-field:focus-within {
    border-color: var(--line);
    background: rgba(5, 5, 5, 0.96);
  }

  .search-field span {
    color: #ff3535;
    font-size: 1.3rem;
    line-height: 1;
  }

  .search-field input {
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
  }

  .search-field input::placeholder {
    color: rgba(244, 241, 236, 0.48);
  }

  .search-field kbd {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--muted);
    padding: 0.1rem 0.35rem;
    font: inherit;
    font-size: 0.7rem;
  }

  .search-results {
    margin-top: 0.45rem;
    padding: 0.75rem;
    border: 1px solid rgba(255, 53, 53, 0.32);
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.42);
  }

  .result-count {
    margin: 0 0 0.55rem;
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .result-list {
    display: grid;
    max-height: min(48vh, 25rem);
    overflow-y: auto;
  }

  .result-list :global(a) {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.6rem;
    padding: 0.72rem 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .result-list :global(a:hover),
  .result-list :global(a:focus-visible) {
    background: rgba(255, 53, 53, 0.1);
  }

  .result-list :global(.result-number) {
    color: #ff3535;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .result-list :global(strong),
  .result-list :global(small) {
    display: block;
  }

  .result-list :global(strong) {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .result-list :global(small) {
    margin-top: 0.28rem;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .result-list :global(.empty-result) {
    margin: 0;
    padding: 0.85rem 0.35rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .globe-controls {
    position: absolute;
    right: 1.6rem;
    bottom: 1.6rem;
    z-index: 4;
    gap: 0.4rem;
  }

  .globe-controls button {
    min-width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(5, 5, 5, 0.82);
    color: var(--text);
    font: inherit;
    font-size: 1.15rem;
    cursor: pointer;
    backdrop-filter: blur(14px);
  }

  .globe-controls button:hover {
    border-color: var(--line);
  }

  .globe-controls .reset-control {
    width: auto;
    padding: 0 0.85rem;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand,
  .brand-sub,
  .header-note,
  .caption-title,
  .caption-meta {
    margin: 0;
    text-transform: uppercase;
  }

  .brand {
    font-size: 0.93rem;
    font-weight: 700;
  }

  .brand-sub {
    margin-top: 0.22rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .header-note {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100svh;
  }

  #globe-canvas {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .caption {
    position: absolute;
    left: 50%;
    bottom: 2.1rem;
    transform: translateX(-50%);
    z-index: 2;
    text-align: center;
    pointer-events: none;
    width: min(92vw, 38rem);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.8);
  }

  .caption-title {
    font-size: clamp(1rem, 1.6vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.3em;
  }

  .caption-meta {
    margin-top: 0.45rem;
    font-size: 0.84rem;
    color: var(--muted);
    letter-spacing: 0.24em;
  }

  /* ---- List view ---- */

  .archive-list {
    padding: 12rem 1.6rem 5rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  .list-heading {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.6rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
  }

  .list-intro {
    margin: 1rem 0 0;
    max-width: 42rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .globe-fallback {
    margin: 1.4rem 0 0;
    padding: 0.8rem 1rem;
    border-left: 2px solid var(--line);
    background: rgba(255, 53, 53, 0.07);
    color: var(--text);
    font-size: 0.85rem;
  }

  .list-grid {
    margin: 2.6rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .list-grid a {
    display: grid;
    grid-template-columns: 2.4rem 5rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    height: 100%;
    padding: 1rem;
    background: var(--bg);
    transition: background 140ms ease;
  }

  .list-grid a:hover,
  .list-grid a:focus-visible {
    background: rgba(255, 53, 53, 0.09);
  }

  .list-number {
    color: #ff3535;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .list-thumb {
    width: 5rem;
    height: 3.75rem;
    object-fit: cover;
    background: var(--bg-soft);
  }

  .list-thumb-empty {
    display: block;
    border: 1px solid rgba(255, 53, 53, 0.4);
    background:
      repeating-linear-gradient(135deg, transparent 0 8px, rgba(255, 255, 255, 0.04) 9px 10px),
      var(--bg-soft);
  }

  .list-copy strong,
  .list-copy small {
    display: block;
  }

  .list-copy strong {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .list-copy small {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    .archive-header {
      padding: 1rem;
    }

    .search-panel {
      top: 4.7rem;
      left: 1rem;
      width: calc(100vw - 2rem);
    }

    .search-label,
    .search-field kbd {
      display: none;
    }

    .search-results {
      max-height: 43svh;
    }

    .globe-controls {
      right: 1rem;
      bottom: 1rem;
      flex-direction: column;
    }

    .globe-controls .reset-control {
      width: 2.75rem;
      padding: 0;
      overflow: hidden;
      color: transparent;
      font-size: 0;
    }

    .globe-controls .reset-control::after {
      content: '↺';
      color: var(--text);
      font-size: 1rem;
    }

    .caption {
      bottom: 1.4rem;
      width: calc(100vw - 8.5rem);
      left: 1rem;
      transform: none;
      text-align: left;
    }

    .caption-title {
      font-size: 0.95rem;
      letter-spacing: 0.22em;
    }

    .caption-meta {
      font-size: 0.73rem;
    }

    .archive-list {
      padding: 10rem 1rem 4rem;
    }

    .list-grid a {
      grid-template-columns: 2rem 4rem minmax(0, 1fr);
      gap: 0.7rem;
    }

    .list-thumb {
      width: 4rem;
      height: 3rem;
    }
  }
</style>
