---
import { projects, archiveTrails, experienceType } from '../data/projects';
const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : base + '/';
const asset = (path: string) => publicBase + path.replace(/^\//, '');
const years = [...new Set(projects.map((project) => project.year))].sort().reverse();
const formats = ['all', ...['watch', 'listen', 'look'].filter((format) => projects.some((project) => experienceType(project) === format))];
const serializedProjects = projects.map((project) => ({ ...project, image: asset(project.image) }));
---

<div class="archive-shell">
  <header class="site-header">
    <a class="wordmark" href={publicBase} aria-label="See My World archive home">
      <img src={asset('/images/events/see-my-world-logo.webp')} alt="See My World" />
    </a>
    <nav aria-label="Main navigation">
      <a href="#browse">Explore</a>
      <a href={publicBase + 'about/'}>About</a>
    </nav>
  </header>

  <main>
    <section class="intro" aria-labelledby="page-title">
      <div class="intro-copy">
        <p class="eyebrow"><span class="pulse" aria-hidden="true"></span> A festival of Pan-African experiences</p>
        <h1 id="page-title">A world of <em>stories.</em></h1>
        <p class="intro-description">
          Watch a moment. Hear a new perspective. Find a familiar face. Explore the films,
          photographs and artist voices of See My World, from Manchester to Lagos and beyond.
        </p>
        <a class="intro-link" href="#start">Find your first story <span aria-hidden="true">↓</span></a>
      </div>
      <div class="intro-aside" aria-hidden="true">
        <span>Manchester</span>
        <span class="intro-line"></span>
        <span>Lagos</span>
        <span class="intro-line"></span>
        <span>Beyond</span>
      </div>
    </section>

    <section class="start-section" id="start" aria-labelledby="start-title">
      <div class="start-heading"><div><span class="section-number">Start anywhere. Stay a while.</span><h2 id="start-title">A little time.<br />A whole world.</h2></div><p>Choose a short trail, or follow your curiosity around the globe. Sound is always your choice; headphones help in a busy room.</p></div>
      <div class="trail-grid">
        {archiveTrails.map((trail, index) => {
          const first = projects.find((project) => project.slug === trail.slugs[0])!;
          return <a class="trail-card" href={publicBase + 'archive/' + first.slug + '/?trail=' + trail.id}>
            <img style={`object-position:50% ${first.imageFocusY ?? 50}%`} src={asset(first.image)} alt={first.alt} loading="lazy" />
            <div class="trail-copy"><small>{String(index + 1).padStart(2, '0')} / {trail.time}</small><h3>{trail.title}</h3><p>{trail.description}</p><span>Begin 3-story trail <span aria-hidden="true">↗</span></span></div>
          </a>;
        })}
      </div>
      <div class="start-bottom"><span>{projects.length} selected projects · Artists, dance, film & live moments</span><button type="button" data-surprise>Surprise me <span aria-hidden="true">↗</span></button><a href="#world">Explore the globe ↓</a></div>
    </section>

    <section class="experience" id="world" aria-label="Interactive archive">
      <div class="globe-side">
        <div class="section-marker"><span>01 / The world</span><span>Drag to explore · Select an image to open</span></div>
        <div class="stage">
          <button class="expand-button" type="button" data-enter-immersive aria-label="Explore the globe full screen"><span aria-hidden="true">⤢</span> Explore full screen</button>
          <div class="immersive-toolbar" data-immersive-toolbar>
            <span class="immersive-brand">SEE MY WORLD <span>/</span> EXPLORE MODE</span>
            <div>
              <button type="button" data-toggle-rail aria-expanded="false" aria-controls="immersive-rail">Stories <span aria-hidden="true">☰</span></button>
              <button type="button" data-close-immersive>Exit full screen <span aria-hidden="true">×</span></button>
            </div>
          </div>
          <canvas id="globe-canvas" aria-label="Interactive archive globe. Browse the event links alongside it for keyboard access."></canvas>
          <div class="globe-center-label" aria-hidden="true"><span>SEE MY</span><span>WORLD</span></div>
          <div class="caption" aria-live="polite">
            <span class="caption-kicker" data-caption-kicker>EXPLORE THE ARCHIVE</span>
            <strong class="caption-title" data-caption-title>Every image holds a story.</strong>
            <span class="caption-meta" data-caption-meta>Drag the globe or choose an event from the list.</span>
          </div>
          <article class="story-preview" data-story-preview hidden aria-labelledby="preview-title">
            <button class="preview-close" type="button" data-close-preview aria-label="Close story preview">×</button>
            <img data-preview-image src={asset(projects[0].image)} alt="" />
            <div class="preview-copy">
              <span data-preview-kicker></span>
              <h3 id="preview-title" data-preview-title></h3>
              <p data-preview-description></p>
              <small data-preview-meta></small>
              <a data-preview-link href="#">Open this story <span aria-hidden="true">↗</span></a>
            </div>
          </article>
          <div class="globe-controls" aria-label="Globe controls">
            <button type="button" data-zoom-in aria-label="Zoom in">+</button>
            <button type="button" data-zoom-out aria-label="Zoom out">−</button>
            <button class="reset-control" type="button" data-reset-view aria-label="Reset globe view">Reset</button>
          </div>
        </div>
        <aside class="immersive-rail" id="immersive-rail" data-immersive-rail aria-label="Explore archive stories">
          <div class="rail-heading"><span>THE ARCHIVE / {projects.length} STORIES</span><button type="button" data-hide-rail aria-label="Close story list">×</button></div>
          <label for="immersive-search">Find a story</label>
          <input id="immersive-search" type="search" placeholder="Search people, places, events…" data-immersive-search />
          <div class="immersive-years" role="group" aria-label="Filter globe by year">
            <button type="button" class="is-active" data-immersive-year="all" aria-pressed="true">All</button>
            {years.map((year) => <button type="button" data-immersive-year={year} aria-pressed="false">{year}</button>)}
          </div>
          <div class="format-filters" role="group" aria-label="Filter globe by experience">
            {formats.map((format) => <button type="button" data-format-button={format} aria-pressed={format === 'all'} class:list={{'is-active': format === 'all'}}>{format === 'all' ? 'Everything' : format === 'watch' ? 'Watch' : format === 'listen' ? 'Listen' : 'Look'}</button>)}
          </div>
          <div class="immersive-stories">
            {projects.map((project) => (
              <button type="button" data-immersive-story={project.slug}>
                <img style={`object-position:50% ${project.imageFocusY ?? 50}%`} src={asset(project.image)} alt="" loading="lazy" />
                <span><small>{project.category} · {project.year}</small><strong>{project.title}</strong></span>
                <span aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
          <p class="immersive-empty" data-immersive-empty hidden>No stories match this search.</p>
        </aside>
        <div class="story-transition" data-story-transition hidden aria-live="polite">
          <img data-transition-image src={asset(projects[0].image)} alt="" />
          <div class="transition-shade"></div>
          <div class="transition-copy"><span>Entering the story</span><strong data-transition-title></strong><small>SEE MY WORLD / THE ARCHIVE</small></div>
        </div>
        <div class="stage-footer"><span>Archive / 2020 to 2025</span><span>Manchester ↔ Lagos</span></div>
      </div>

      <aside class="discover-panel" aria-labelledby="discover-title">
        <div class="discover-heading">
          <span class="section-number">02 / Discover</span>
          <h2 id="discover-title">Find your way in.</h2>
          <p>Follow an artist, a film or a photograph. Search by place, year or theme; the globe and collection respond together.</p>
        </div>
        <label class="search-label" for="archive-search">Search the archive</label>
        <div class="search-field">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input id="archive-search" type="search" placeholder="Try Lagos, film, 2024…" autocomplete="off" data-search-input />
          <kbd>/</kbd>
        </div>
        <div class="filter-header"><span>By year</span><span data-result-count aria-live="polite">{projects.length} stories</span></div>
        <div class="year-filters" role="group" aria-label="Filter by year">
          <button type="button" class="is-active" data-year-button="all" aria-pressed="true">All years</button>
          {years.map((year) => <button type="button" data-year-button={year} aria-pressed="false">{year}</button>)}
        </div>
        <div class="format-filters" role="group" aria-label="Filter by experience">
          {formats.map((format) => <button type="button" data-format-button={format} aria-pressed={format === 'all'} class:list={{'is-active': format === 'all'}}>{format === 'all' ? 'Everything' : format === 'watch' ? 'Watch' : format === 'listen' ? 'Listen' : 'Look'}</button>)}
        </div>
        <div class="result-list" data-result-list>
          {projects.map((project) => (
            <a href={publicBase + 'archive/' + project.slug + '/'} data-result-link={project.slug} data-year={project.year}>
              <img style={`object-position:50% ${project.imageFocusY ?? 50}%`} src={asset(project.image)} alt="" loading="lazy" />
              <span class="result-copy">
                <small>{experienceType(project)} <span aria-hidden="true">·</span> {project.year}</small>
                <strong>{project.title}</strong>
                <span class="result-duration">{project.visitLabel ?? project.category}</span>
              </span>
              <span class="result-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="empty-result" data-empty-result hidden>No stories match your search. Try a different word or year.</p>
      </aside>
    </section>

    <section class="browse-section" id="browse" aria-labelledby="browse-title">
      <div class="browse-heading">
        <div><span class="section-number">03 / The collection</span><h2 id="browse-title">Explore every story<span class="green-dot">.</span></h2></div>
        <p>Stay for thirty seconds or follow a whole thread. Meet the artists, feel the movement and look closer at the people behind each moment.</p>
      </div>
      <div class="project-grid" data-project-grid>
        {projects.map((project) => (
          <a class="project-card" href={publicBase + 'archive/' + project.slug + '/'} data-project-card data-year={project.year} data-slug={project.slug}>
            <div class="project-image"><img style={`object-position:50% ${project.imageFocusY ?? 50}%`} src={asset(project.image)} alt={project.alt} loading="lazy" /><span class="format-badge">{experienceType(project)}</span><span class="card-action" aria-hidden="true">↗</span></div>
            <div class="card-topline"><span>{project.category}</span><span>{project.year}</span></div>
            <h3>{project.title}</h3>
            <p>{project.visitLabel ?? project.venue}</p>
          </a>
        ))}
      </div>
      <p class="grid-empty" data-grid-empty hidden>No stories found for this search.</p>
    </section>
  </main>

  <footer class="site-footer">
    <span>SEE MY WORLD <span class="footer-green">/</span> AN INTERACTIVE ARCHIVE</span>
    <a href={publicBase + 'about/'}>About See My World ↗</a>
  </footer>
</div>

<script type="application/json" id="archive-project-data" set:html={JSON.stringify(serializedProjects)}></script>
<script>import '../scripts/archive-globe';</script>

<style>
  .start-section { padding: 3.5rem clamp(1.25rem,5vw,6rem); border-bottom: 1px solid #722322; }
  .start-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.8rem; }
  .start-heading h2 { font-size: clamp(2.4rem,4.3vw,4.8rem); line-height: .98; letter-spacing: -.06em; text-transform: uppercase; margin: .9rem 0 0; }
  .start-heading > p { max-width: 330px; color: #b3b8ae; font-size: .9rem; line-height: 1.6; }
  .trail-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .trail-card { position: relative; background: #0e120e; border: 1px solid #59332c; overflow: hidden; }
  .trail-card > img { width: 100%; height: 210px; object-fit: cover; transition: transform .25s; }
  .trail-card:hover > img { transform: scale(1.025); }
  .trail-card:focus-visible { outline: 2px solid #69b96e; outline-offset: 4px; }
  .trail-copy { padding: 1.25rem; }
  .trail-copy small { color: #69b96e; font-size: .63rem; letter-spacing: .1em; text-transform: uppercase; }
  .trail-copy h3 { text-transform: uppercase; font-size: clamp(1.2rem,1.8vw,1.9rem); line-height: 1.05; margin: .65rem 0; }
  .trail-copy p { color: #b3b8ae; font-size: .85rem; line-height: 1.5; min-height: 2.6em; }
  .trail-copy > span { font-size: .65rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .trail-copy > span span { color: #69b96e; margin-left: .8rem; }
  .start-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 1.5rem; font-size: .7rem; }
  .start-bottom > span { color: #aeb4ac; margin-right: auto; }
  .start-bottom button { font: inherit; color: #050505; background: #69b96e; border: 1px solid #69b96e; min-height: 44px; padding: .8rem 1rem; font-weight: 800; cursor: pointer; }
  .start-bottom a { display: inline-flex; align-items: center; min-height: 44px; }
  .format-filters { display: flex; gap: .35rem; flex-wrap: wrap; margin: -.6rem 0 1.2rem; }
  .format-filters button { min-height: 44px; background: #111; border: 1px solid #51534c; color: #d2d7cc; font: inherit; font-size: .68rem; font-weight: 800; padding: .55rem .65rem; cursor: pointer; }
  .format-filters button.is-active { color: #050505; background: #69b96e; border-color: #69b96e; }
  .format-filters button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .result-duration { color: #aeb4ac; font-size: .65rem; line-height: 1.3; }
  .format-badge { position: absolute; top: .7rem; left: .7rem; background: #050505dc; color: #fff; border: 1px solid #ffffff50; padding: .4rem .6rem; font-size: .6rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  @media(max-width:680px) { .start-heading { display: block; } .start-heading > p { max-width: 100%; } .trail-grid { grid-template-columns: 1fr; } .trail-card { display: grid; grid-template-columns: 35% 1fr; } .trail-card > img { height: 100%; min-height: 190px; } .trail-copy { padding: 1rem; } .start-bottom > span { width: 100%; } }
  .archive-shell { min-height: 100vh; background: #050505; color: #f8f8f5; }
  .site-header { min-height: 106px; border-bottom: 1px solid #722322; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.4rem clamp(1.25rem, 3vw, 3.5rem); }
  .wordmark { display: block; width: min(430px, 39vw); }
  .wordmark img { width: 100%; height: auto; }
  .site-header nav { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2.5rem); }
  .site-header nav a { font-size: .69rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; white-space: nowrap; }
  .site-header nav a:hover, .site-header nav a:focus-visible, .site-footer a:hover { color: #70bd73; }
  .site-header nav span { color: #ef4b43; }
  .intro { min-height: 360px; display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: clamp(3.5rem, 6vw, 6.5rem) clamp(1.25rem, 5vw, 6rem) 3.3rem; border-bottom: 1px solid #722322; position: relative; overflow: hidden; }
  .intro::after { content: ''; position: absolute; right: 8%; top: -130px; width: 530px; height: 530px; border: 1px solid rgba(239,75,67,.11); border-radius: 50%; pointer-events: none; }
  .intro-copy { max-width: 830px; position: relative; z-index: 1; }
  .eyebrow, .section-number { color: #ef4b43; text-transform: uppercase; letter-spacing: .17em; font-size: .72rem; font-weight: 800; }
  .eyebrow { margin: 0 0 1.35rem; display: flex; align-items: center; gap: .6rem; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: #ef4b43; box-shadow: 0 0 0 5px rgba(239,75,67,.15); }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 1.25rem; font-size: clamp(3.5rem, 6.3vw, 7.5rem); line-height: .91; letter-spacing: -.075em; text-transform: uppercase; max-width: 12ch; }
  h1 em { color: #69b96e; font-style: normal; }
  .intro-description { max-width: 580px; color: #b6b7b1; font-size: clamp(1rem, 1.2vw, 1.16rem); line-height: 1.6; }
  .intro-link { display: inline-flex; gap: 1.4rem; align-items: center; border-bottom: 1px solid #ef4b43; padding-bottom: .52rem; margin-top: .8rem; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .intro-link span { color: #ef4b43; font-size: 1.1rem; }
  .intro-link:hover { color: #69b96e; }
  .intro-aside { display: flex; align-items: center; gap: .65rem; writing-mode: vertical-rl; text-transform: uppercase; letter-spacing: .2em; color: #888d86; font-size: .62rem; font-weight: 700; white-space: nowrap; }
  .intro-line { display: block; height: 28px; width: 1px; background: #ef4b43; }
  .experience { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(360px, .8fr); min-height: 660px; border-bottom: 1px solid #722322; }
  .globe-side { min-width: 0; border-right: 1px solid #722322; display: flex; flex-direction: column; position: relative; }
  .section-marker, .stage-footer { display: flex; justify-content: space-between; gap: 1rem; color: #888d86; font-size: .64rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .section-marker { padding: 1.2rem 1.7rem; border-bottom: 1px solid rgba(165,48,46,.45); }
  .section-marker span:first-child { color: #ef4b43; }
  .stage-footer { padding: 1rem 1.7rem; border-top: 1px solid rgba(165,48,46,.45); }
  .stage { flex: 1; min-height: 580px; position: relative; background: #050303; overflow: hidden; isolation: isolate; }
  .stage::before { content: ''; position: absolute; z-index: -1; inset: 0; background: radial-gradient(ellipse 70% 64% at 52% 48%, rgba(151,31,25,.48), rgba(35,4,5,.62) 42%, #030303 77%); pointer-events: none; }
  .stage::after { content: ''; position: absolute; z-index: 0; inset: 0; background: linear-gradient(90deg, #05050588, transparent 23%, transparent 76%, #05050588), linear-gradient(0deg, #050505bd, transparent 25%, transparent 75%, #0505059c); pointer-events: none; }
  #globe-canvas { display: block; width: 100%; height: 100%; touch-action: none; }
  #globe-canvas:focus-visible { outline: 2px solid #69b96e; outline-offset: -5px; }
  .expand-button { position: absolute; z-index: 6; top: 1.1rem; right: 1.2rem; display: flex; align-items: center; gap: .65rem; min-height: 2.8rem; padding: 0 .9rem; border: 1px solid #a03b36; background: #080808ec; color: #fff; text-transform: uppercase; letter-spacing: .12em; font: inherit; font-size: .66rem; font-weight: 900; cursor: pointer; }
  .expand-button span { color: #69b96e; font-size: 1.35rem; line-height: 1; }
  .expand-button:hover, .expand-button:focus-visible { background: #69b96e; border-color: #69b96e; color: #050505; }
  .expand-button:hover span, .expand-button:focus-visible span { color: #050505; }
  .immersive-toolbar, .immersive-rail { display: none; }
  .story-preview { position: absolute; z-index: 11; left: 1.5rem; bottom: 5.8rem; display: grid; grid-template-columns: 125px minmax(0,1fr); width: min(500px, calc(100% - 3rem)); min-height: 176px; background: #090c09f5; border: 1px solid #69b96e; box-shadow: 0 18px 60px #000b; }
  .story-preview[hidden], .immersive-stories button[hidden], .immersive-empty[hidden] { display: none !important; }
  .story-transition { position: fixed; inset: 0; z-index: 1001; overflow: hidden; background: #080808; opacity: 0; pointer-events: none; transition: opacity .24s ease; }
  .story-transition[hidden] { display: none !important; }
  .story-transition.is-active { opacity: 1; pointer-events: auto; }
  .story-transition > img { width: 100%; height: 100%; object-fit: cover; transform: scale(.86); filter: brightness(.6); transition: transform .65s cubic-bezier(.2,.7,.1,1), filter .65s ease; }
  .story-transition.is-active > img { transform: scale(1.08); filter: brightness(1); }
  .transition-shade { position: absolute; inset: 0; background: linear-gradient(90deg, #000d, #0005 75%), linear-gradient(0deg, #000c, transparent 60%); }
  .transition-copy { position: absolute; inset: auto 5vw 8vh; display: flex; flex-direction: column; gap: 1rem; text-transform: uppercase; opacity: 0; transform: translateY(24px); transition: opacity .4s .1s ease, transform .4s .1s ease; }
  .story-transition.is-active .transition-copy { opacity: 1; transform: translateY(0); }
  .transition-copy span, .transition-copy small { color: #69b96e; font-size: .7rem; font-weight: 900; letter-spacing: .17em; }
  .transition-copy strong { color: #fff; max-width: 13ch; font-size: clamp(3rem, 7vw, 8rem); line-height: .91; letter-spacing: -.065em; }
  .transition-copy small { color: #fff; font-size: .6rem; }
  .story-preview > img { width: 100%; height: 100%; object-fit: cover; }
  .preview-copy { min-width: 0; padding: 1.1rem 1.5rem 1rem 1.1rem; }
  .preview-copy > span, .preview-copy small { color: #69b96e; font-size: .61rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .preview-copy h3 { font-size: clamp(1rem, 1.5vw, 1.4rem); line-height: 1.05; text-transform: uppercase; margin: .42rem 0 .5rem; }
  .preview-copy p { color: #c6cbc4; font-size: .73rem; line-height: 1.4; margin: 0 0 .55rem; }
  .preview-copy small { display: block; color: #aeb4ac; letter-spacing: .06em; }
  .preview-copy a { display: inline-flex; gap: .7rem; margin-top: .7rem; border-bottom: 1px solid #ef4b43; padding-bottom: .28rem; font-size: .64rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .preview-copy a span { color: #ef4b43; }
  .preview-copy a:hover { color: #69b96e; }
  .preview-close { position: absolute; top: .25rem; right: .35rem; border: 0; background: transparent; color: #fff; font-size: 1.4rem; cursor: pointer; }
  .globe-side.is-immersive, .globe-side:fullscreen { position: fixed; inset: 0; z-index: 1000; width: 100%; height: 100dvh; border: 0; background: #050505; }
  .globe-side.is-immersive .section-marker, .globe-side:fullscreen .section-marker, .globe-side.is-immersive .stage-footer, .globe-side:fullscreen .stage-footer, .globe-side.is-immersive .expand-button, .globe-side:fullscreen .expand-button { display: none; }
  .globe-side.is-immersive .stage, .globe-side:fullscreen .stage { min-height: 0; width: 100%; }
  .globe-side.is-immersive .immersive-toolbar, .globe-side:fullscreen .immersive-toolbar { position: absolute; z-index: 12; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 64px; padding: 0 1.5rem; border-bottom: 1px solid #682421; background: #050505e8; }
  .immersive-brand { font-size: .78rem; font-weight: 900; letter-spacing: .16em; white-space: nowrap; }
