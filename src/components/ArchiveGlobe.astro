---
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
const publicBase = base.endsWith('/') ? base : `${base}/`;
const asset = (path: string) => `${publicBase}${path.replace(/^\//, '')}`;
const serializedProjects = projects.map((project) => ({
  ...project,
  image: asset(project.image),
}));
---

<section class="archive-shell">
  <header class="archive-header">
    <div>
      <p class="brand">SEE MY WORLD</p>
      <p class="brand-sub">ARCHIVE</p>
    </div>
    <div class="header-note">DRAG, SCROLL OR USE ARROW KEYS</div>
  </header>

  <section class="search-panel" aria-label="Search the archive">
    <label class="search-label" for="archive-search">Search the archive</label>
    <div class="search-field">
      <span aria-hidden="true">⌕</span>
      <input
        id="archive-search"
        type="search"
        placeholder="Projects, places, years…"
        autocomplete="off"
        data-search-input
      />
      <kbd>/</kbd>
    </div>
    <div class="search-results" data-search-results hidden>
      <p class="result-count" data-result-count aria-live="polite"></p>
      <div class="result-list" data-result-list></div>
    </div>
  </section>

  <div class="globe-controls" aria-label="Globe controls">
    <button type="button" data-zoom-in aria-label="Zoom in">+</button>
    <button type="button" data-zoom-out aria-label="Zoom out">−</button>
    <button class="reset-control" type="button" data-reset-view>Reset view</button>
  </div>

  <div class="stage">
    <div class="caption" aria-live="polite">
      <div class="caption-title" data-caption-title>DRAG TO EXPLORE · SELECT TO OPEN</div>
      <div class="caption-meta" data-caption-meta></div>
    </div>
    <canvas id="globe-canvas" aria-label="Interactive archive globe"></canvas>
  </div>
</section>

<script type="application/json" id="archive-project-data" set:html={JSON.stringify(serializedProjects)}></script>
<script type="module" src={`${publicBase}archive-globe.js`}></script>

<style>
  .archive-shell {
    position: relative;
    min-height: 100svh;
    background:
      radial-gradient(circle at 50% 44%, rgba(255, 46, 46, 0.08), transparent 28%),
      radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.04), transparent 36%),
      var(--bg);
    overflow: hidden;
  }

  .archive-header {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.5rem 1.6rem;
    z-index: 2;
    pointer-events: none;
    letter-spacing: 0.26em;
  }

  .search-panel {
    position: absolute;
    top: 6.2rem;
    left: 1.6rem;
    z-index: 4;
    width: min(23rem, calc(100vw - 3.2rem));
  }

  .search-label {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .search-field {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 3rem;
    padding: 0 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(5, 5, 5, 0.84);
    backdrop-filter: blur(16px);
    transition: border-color 160ms ease, background 160ms ease;
  }

  .search-field:focus-within {
    border-color: var(--line);
    background: rgba(5, 5, 5, 0.96);
  }

  .search-field span {
    color: #ff3535;
    font-size: 1.3rem;
    line-height: 1;
  }

  .search-field input {
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
  }

  .search-field input::placeholder {
    color: rgba(244, 241, 236, 0.48);
  }

  .search-field kbd {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--muted);
    padding: 0.1rem 0.35rem;
    font: inherit;
    font-size: 0.7rem;
  }

  .search-results {
    margin-top: 0.45rem;
    padding: 0.75rem;
    border: 1px solid rgba(255, 53, 53, 0.32);
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(18px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.42);
  }

  .result-count {
    margin: 0 0 0.55rem;
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .result-list {
    display: grid;
    max-height: min(48vh, 25rem);
    overflow-y: auto;
  }

  .result-list :global(a) {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.6rem;
    padding: 0.72rem 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .result-list :global(a:hover),
  .result-list :global(a:focus-visible) {
    background: rgba(255, 53, 53, 0.1);
    outline: none;
  }

  .result-list :global(.result-number) {
    color: #ff3535;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .result-list :global(strong),
  .result-list :global(small) {
    display: block;
  }

  .result-list :global(strong) {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .result-list :global(small) {
    margin-top: 0.28rem;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .result-list :global(.empty-result) {
    margin: 0;
    padding: 0.85rem 0.35rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .globe-controls {
    position: absolute;
    right: 1.6rem;
    bottom: 1.6rem;
    z-index: 4;
    display: flex;
    gap: 0.4rem;
  }

  .globe-controls button {
    min-width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(5, 5, 5, 0.82);
    color: var(--text);
    font: inherit;
    font-size: 1.15rem;
    cursor: pointer;
    backdrop-filter: blur(14px);
  }

  .globe-controls button:hover,
  .globe-controls button:focus-visible {
    border-color: var(--line);
    outline: none;
  }

  .globe-controls .reset-control {
    width: auto;
    padding: 0 0.85rem;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand,
  .brand-sub,
  .header-note,
  .caption-title,
  .caption-meta {
    margin: 0;
    text-transform: uppercase;
  }

  .brand {
    font-size: 0.93rem;
    font-weight: 700;
  }

  .brand-sub {
    margin-top: 0.22rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .header-note {
    margin-top: 0.16rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100svh;
  }

  #globe-canvas {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .caption {
    position: absolute;
    left: 50%;
    bottom: 2.1rem;
    transform: translateX(-50%);
    z-index: 2;
    text-align: center;
    pointer-events: none;
    width: min(92vw, 38rem);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.8);
  }

  .caption-title {
    font-size: clamp(1rem, 1.6vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.3em;
  }

  .caption-meta {
    margin-top: 0.45rem;
    font-size: 0.84rem;
    color: var(--muted);
    letter-spacing: 0.24em;
  }

  @media (max-width: 760px) {
    .archive-header {
      padding: 1rem 1rem;
    }

    .search-panel {
      top: 4.7rem;
      left: 1rem;
      width: calc(100vw - 2rem);
    }

    .search-label,
    .search-field kbd {
      display: none;
    }

    .search-results {
      max-height: 43svh;
    }

    .globe-controls {
      right: 1rem;
      bottom: 1rem;
      flex-direction: column;
    }

    .globe-controls .reset-control {
      width: 2.75rem;
      padding: 0;
      overflow: hidden;
      color: transparent;
      font-size: 0;
    }

    .globe-controls .reset-control::after {
      content: '↺';
      color: var(--text);
      font-size: 1rem;
    }

    .header-note {
      display: none;
    }

    .caption {
      bottom: 1.4rem;
      width: calc(100vw - 8.5rem);
      left: 1rem;
      transform: none;
      text-align: left;
    }

    .caption-title {
      font-size: 0.95rem;
      letter-spacing: 0.22em;
    }

    .caption-meta {
      font-size: 0.73rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #globe-canvas {
      scroll-behavior: auto;
    }
  }
</style>
